'use client'

import { useState, useEffect } from 'react'
import { fetchPaperTrades, type PaperTrade } from '../lib/supabase'
import { fmtPnl } from '../lib/helpers'

const AGENT_WALLET = '0x4fE6F5E7bF636B5eA13b11f8cEfc7E24c5f12eE5'
const RAYDIUM_URL = 'https://raydium.io'

// ── Helpers ─────────────────────────────────────────────────────────────────

function truncateTitle(t: string): string {
  return t.length > 52 ? t.slice(0, 49) + '…' : t
}

function liveLabel(trade: PaperTrade): string {
  if (trade.result === 'won') return `WON +${(Number(trade.payout_units ?? 0) - Number(trade.stake_units ?? 0)).toFixed(2)}u`
  if (trade.result === 'lost') return `LOST -${Number(trade.stake_units ?? 0).toFixed(2)}u`
  return `OPEN · ${(Number(trade.expected_edge ?? 0)).toFixed(1)}pp EDGE`
}

function copyToClipboard(text: string) {
  navigator.clipboard.writeText(text).catch(() => {})
}

// ── Page ─────────────────────────────────────────────────────────────────────

export default function LandingPage() {
  const [trades, setTrades] = useState<PaperTrade[]>([])
  const [copied, setCopied] = useState(false)

  useEffect(() => {
    fetchPaperTrades().then(setTrades)
  }, [])

  // Derived metrics
  const settled   = trades.filter(t => t.result === 'won' || t.result === 'lost')
  const wins      = settled.filter(t => t.result === 'won').length
  const winRate   = settled.length > 0 ? (wins / settled.length) * 100 : 0
  const totalPnl  = settled.reduce((s, t) => s + Number(t.payout_units ?? 0) - Number(t.stake_units ?? 0), 0)
  const liveTrades = trades.filter(t => t.pm_live)
  const bankroll  = liveTrades.reduce((s, t) => s + Number(t.pm_order_size ?? 0) * Number(t.pm_order_price ?? 0), 0)
  const latest3   = trades.slice(0, 3)

  function handleCopy() {
    copyToClipboard(AGENT_WALLET)
    setCopied(true)
    setTimeout(() => setCopied(false), 2000)
  }

  return (
    <div className="lp-root">

      {/* ── NAV ── */}
      <nav className="lp-nav">
        <a href="/" className="lp-brand">
          <span className="lp-brand-title">NOPREDICTIONS</span>
          <span className="lp-brand-sub">$NOPRED · AUTONOMOUS CAPITALISM</span>
        </a>
        <div className="lp-nav-links">
          <a href="/" className="lp-nav-link">DASHBOARD</a>
          <a href="/scanner" className="lp-nav-link">SCANNER</a>
          <a href={RAYDIUM_URL} target="_blank" rel="noopener noreferrer" className="lp-nav-cta">
            BUY $NOPRED ↗
          </a>
        </div>
      </nav>

      {/* ── 1 · HERO ── */}
      <section className="lp-hero">
        <div className="lp-wrap">
          <div className="lp-eyebrow">● AI AGENT · ON-CHAIN · LIVE</div>
          <h1 className="lp-h1">
            YOU CAN&apos;T BEAT THE MARKET.<br />
            <span className="lp-accent">BUT THE MACHINE CAN.</span>
          </h1>
          <p className="lp-sub">
            Capital is moving on-chain. NoPredictions is a 100% autonomous AI agent
            that finds mispricings in prediction markets and converts edge into token value.
            30% of every profit burns $NOPRED permanently.
            No discretion. No humans. Just math.
          </p>
          <div className="lp-cta-row">
            <a href="/" className="lp-btn-primary">● SEE AGENT LIVE</a>
            <a href={RAYDIUM_URL} target="_blank" rel="noopener noreferrer" className="lp-btn-secondary">
              BUY $NOPRED ↗
            </a>
          </div>

          {/* Live bets feed */}
          <div className="lp-feed">
            <div className="lp-feed-label">● LATEST POSITIONS</div>
            {latest3.length === 0 ? (
              <div className="lp-feed-empty">Loading…</div>
            ) : (
              latest3.map(t => (
                <div key={t.id} className={`lp-feed-row ${t.result === 'won' ? 'lp-feed-won' : t.result === 'lost' ? 'lp-feed-lost' : ''}`}>
                  <span className="lp-feed-title">{truncateTitle(t.market_title)}</span>
                  <span className={`lp-feed-result ${t.result === 'won' ? 'lp-green' : t.result === 'lost' ? 'lp-red' : 'lp-grey'}`}>
                    {liveLabel(t)}
                  </span>
                </div>
              ))
            )}
          </div>
        </div>
      </section>

      {/* ── 2 · PHILOSOPHY ── */}
      <section className="lp-section lp-section-alt">
        <div className="lp-wrap">
          <div className="lp-section-eyebrow">THE THESIS</div>
          <blockquote className="lp-quote">
            "In a future where machines generate all capital, what is the role of humans?
            To own the token the machine is forced to appreciate."
          </blockquote>
          <p className="lp-body">
            NoPredictions doesn&apos;t ask for subscriptions, doesn&apos;t sell courses and doesn&apos;t
            manage your money. <strong>It operates alone.</strong> By holding the token, you gain
            direct exposure to the mathematical efficiency of an algorithm that works 24/7
            to appreciate the ecosystem — across every match, every market, every edge.
          </p>
        </div>
      </section>

      {/* ── 3 · FLYWHEEL ── */}
      <section className="lp-section">
        <div className="lp-wrap">
          <div className="lp-section-eyebrow">HOW IT WORKS</div>
          <h2 className="lp-h2">The $NOPRED Flywheel</h2>
          <div className="lp-steps">

            <div className="lp-step">
              <div className="lp-step-num">01</div>
              <div className="lp-step-title">AUTONOMOUS INTELLIGENCE</div>
              <div className="lp-step-body">
                Our agent monitors dozens of prediction markets (Polymarket, etc.) in real-time,
                cross-referencing global sharp data in milliseconds to find mispriced odds.
                139,000+ historical matches. 7 active strategies. Zero human intervention.
              </div>
            </div>

            <div className="lp-step">
              <div className="lp-step-num">02</div>
              <div className="lp-step-title">ON-CHAIN EXECUTION</div>
              <div className="lp-step-body">
                The bot executes positions autonomously using its own on-chain bankroll on Polygon.
                Every trade is cryptographically signed, immutably recorded and publicly verifiable
                on-chain — no trust required.
              </div>
            </div>

            <div className="lp-step">
              <div className="lp-step-num">03</div>
              <div className="lp-step-title">BUYBACK &amp; BURN</div>
              <div className="lp-step-body">
                30% of all profits generated by the agent are automatically sent to the open market
                to purchase $NOPRED tokens. These tokens are sent to a dead address and destroyed
                forever — permanently reducing supply.
              </div>
            </div>

          </div>
        </div>
      </section>

      {/* ── 4 · DASHBOARD / PROOF OF TRADE ── */}
      <section className="lp-section lp-section-alt">
        <div className="lp-wrap">
          <div className="lp-section-eyebrow">PROOF OF TRADE</div>
          <h2 className="lp-h2">Radical Transparency.<br />Zero Promises, Just Code.</h2>

          <div className="lp-metrics">
            <div className="lp-metric">
              <div className="lp-metric-val lp-green">
                {bankroll > 0 ? `$${bankroll.toFixed(0)}` : `${trades.filter(t => !t.resolved_at).length}`}
              </div>
              <div className="lp-metric-label">{bankroll > 0 ? 'AGENT BANKROLL' : 'OPEN POSITIONS'}</div>
            </div>
            <div className="lp-metric">
              <div className="lp-metric-val">{settled.length > 0 ? `${winRate.toFixed(1)}%` : '—'}</div>
              <div className="lp-metric-label">WIN RATE</div>
            </div>
            <div className="lp-metric">
              <div className={`lp-metric-val ${totalPnl >= 0 ? 'lp-green' : 'lp-red'}`}>
                {settled.length > 0 ? fmtPnl(totalPnl) : '—'}
              </div>
              <div className="lp-metric-label">TOTAL P&amp;L</div>
            </div>
            <div className="lp-metric">
              <div className="lp-metric-val">{settled.length}</div>
              <div className="lp-metric-label">SETTLED BETS</div>
            </div>
          </div>

          <div className="lp-wallet-row">
            <div className="lp-wallet-label">AGENT ADDRESS</div>
            <div className="lp-wallet">
              <code className="lp-wallet-addr">{AGENT_WALLET}</code>
              <button className="lp-wallet-copy" onClick={handleCopy}>
                {copied ? 'COPIED ✓' : 'COPY'}
              </button>
            </div>
          </div>

          <div className="lp-cta-row" style={{ marginTop: '32px' }}>
            <a href="/" className="lp-btn-secondary">VIEW FULL DASHBOARD →</a>
          </div>
        </div>
      </section>

      {/* ── 5 · TOKENOMICS ── */}
      <section className="lp-section">
        <div className="lp-wrap">
          <div className="lp-section-eyebrow">TOKENOMICS</div>
          <h2 className="lp-h2">Where Profits Go</h2>
          <p className="lp-body" style={{ maxWidth: 560, marginBottom: 32 }}>
            Every fraction of profit generated by the agent is allocated with mathematical precision.
            No discretion, no exceptions.
          </p>

          <div className="lp-tknm">
            <div className="lp-tknm-row">
              <div className="lp-tknm-pct" style={{ color: 'var(--accent)' }}>60%</div>
              <div className="lp-tknm-info">
                <div className="lp-tknm-name">COMPOUND INTEREST · GROWTH</div>
                <div className="lp-tknm-desc">Returns to the agent&apos;s main bankroll. The larger the bankroll, the larger the positions and the larger the future profits.</div>
              </div>
              <div className="lp-tknm-bar-wrap">
                <div className="lp-tknm-bar" style={{ width: '60%', background: 'var(--accent)' }} />
              </div>
            </div>
            <div className="lp-tknm-row">
              <div className="lp-tknm-pct lp-purple">30%</div>
              <div className="lp-tknm-info">
                <div className="lp-tknm-name">BUYBACK &amp; BURN</div>
                <div className="lp-tknm-desc">Market buy and destruction of $NOPRED tokens. Each burn event is on-chain and permanent — benefiting every holder.</div>
              </div>
              <div className="lp-tknm-bar-wrap">
                <div className="lp-tknm-bar" style={{ width: '30%', background: '#a855f7' }} />
              </div>
            </div>
            <div className="lp-tknm-row">
              <div className="lp-tknm-pct lp-grey">10%</div>
              <div className="lp-tknm-info">
                <div className="lp-tknm-name">INFRASTRUCTURE &amp; DEVS</div>
                <div className="lp-tknm-desc">Servers, APIs, and AI model development to keep the agent running and improving.</div>
              </div>
              <div className="lp-tknm-bar-wrap">
                <div className="lp-tknm-bar" style={{ width: '10%', background: 'var(--grey)' }} />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ── 6 · FOOTER CTA ── */}
      <section className="lp-section lp-section-cta">
        <div className="lp-wrap" style={{ textAlign: 'center' }}>
          <div className="lp-section-eyebrow">JOIN THE PROTOCOL</div>
          <h2 className="lp-h2">Join the economy governed<br />by artificial intelligence.</h2>
          <div className="lp-cta-row" style={{ justifyContent: 'center', marginTop: 32 }}>
            <a href={RAYDIUM_URL} target="_blank" rel="noopener noreferrer" className="lp-btn-primary">
              BUY $NOPRED ↗
            </a>
            <a href="/" className="lp-btn-secondary">SEE AGENT LIVE →</a>
          </div>
          <div className="lp-footer-links">
            <a href="https://x.com" target="_blank" rel="noopener noreferrer">X / TWITTER</a>
            <a href="https://t.me" target="_blank" rel="noopener noreferrer">TELEGRAM</a>
            <a href="https://discord.com" target="_blank" rel="noopener noreferrer">DISCORD</a>
            <a href={`https://solscan.io/address/${AGENT_WALLET}`} target="_blank" rel="noopener noreferrer">SOLSCAN</a>
          </div>
          <div className="lp-footer-legal">
            NOPREDICTIONS © 2026 · NOT FINANCIAL ADVICE · AI VS PREDICTION MARKETS
          </div>
        </div>
      </section>

    </div>
  )
}
