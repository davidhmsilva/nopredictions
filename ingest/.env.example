# Supabase / Postgres connection.
#
# Get your connection string from: Supabase Dashboard -> Project Settings
# -> Database -> Connection string -> "URI" tab.
#
# Two options:
#   - Direct connection (port 5432): best for long-running ingestion scripts
#   - Session pooler (port 5432) or Transaction pooler (6543): better for
#     serverless/short-lived. For Stage A, direct connection is fine.
#
# Replace [YOUR-PASSWORD] with your database password.

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Anthropic API key for the research agent (model: claude-opus-4-6)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# The Odds API — aggregates Pinnacle, Betfair Exchange, and other books.
# Free tier: 500 requests/month (dev only). Paid tier $59/mo for live tracking.
# Get key at https://the-odds-api.com/
THE_ODDS_API_KEY=

# Polymarket — public APIs, no auth required. Parameterised for clarity / future-proofing.
# Gamma API: market metadata + resolution
# CLOB API: order book + trades
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
