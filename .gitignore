# Dependencies
node_modules/
.venv/
.venv-pm/

# Build output
.next/
*.pyc
__pycache__/

# Environment & secrets
.env
.env.save
.env.local
.env.production.local
# timestamped backups written by the key-rotation scripts — these carry
# DATABASE_URL and POLYMARKET_PRIVATE_KEY, so match them broadly
.env.bak*
.env.*.bak
.env.backup*

# Cache
.cache/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Vercel
.vercel/

# IDE
.vscode/
.idea/

# TypeScript build info
tsconfig.tsbuildinfo

# Agent dev artefacts
agent/diary/
agent/package.json
agent/package-lock.json
agent/node_modules/
.claude/scheduled_tasks.lock
# Claude Code worktrees. These were tracked as gitlinks, which left six full
# checkouts of old code sharing the production DATABASE_URL — a stale resolver
# run from any of them reintroduced the NET-style payout bug twice. See
# db/025_payout_units_gross_guard.sql.
.claude/worktrees/

# Wallet bootstrap scripts (contain private-key handling)
ingest/gen_pm_wallet.py
ingest/add_pm_key.sh
.vercel
# cron_guard.sh cadence state — machine-local, never shared
agent/.cron_guard/

# Lag recorder raw captures — hundreds of MB per match, regenerable by re-recording.
# The whole directory, not a glob: the first capture to be gzipped (a 40MB
# .jsonl.gz) slipped straight past `*.jsonl` and would have been committed.
reports/lag/

# pressure_daemon.sh liveness stamp (D6) — proves the wrapper can still
# write this directory. Local runtime state, never committed.
agent/.pressure_heartbeat

# api-football call counters — per-process, per-UTC-day, one writer each.
# Local runtime state: committing them would hand another machine a spend total
# that is not its own and ration it against a day it never had.
agent/.af_calls_*.json
# nfl_agent: the last Odds API snapshot (credits are rationed) and its run lock
agent/.nfl_odds_cache.json
agent/.nfl_agent.lock
agent/.af_tmp_*

# Row-level audit dumps — 12.8MB of CSV whose rows all still exist in Postgres.
# Kept on disk as the record behind db/036 and db/038; not in git history, where
# they are permanent and every clone pays for them. The findings that cite them
# by name carry the numbers themselves.
reports/pressure_obs_dupes_backup_*.csv
reports/pressure_stats_frozen_retracted_*.csv
reports/deleted_orphan_paper_trades_*.csv
stuck_trades_*.csv
ingest/_deleted_*.csv

.next-gc/
# strategy factory: pickled tapes (rebuilt from the DB) and cron locks
agent/factory/cache/
agent/.factory_*.lock
# soccer_live_recorder: every in-play soccer market, every minute (large, machine-local)
agent/data/soccer_live/
agent/.soccer_live_recorder.lock
agent/.soccer_live_settle.lock
# nfl_live_recorder: raw in-play recordings (large, machine-local) and its lock
agent/data/nfl_live/
agent/.nfl_live_recorder.lock
